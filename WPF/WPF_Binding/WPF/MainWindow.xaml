<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp"
        Title="Custom Data Binding Example" Height="300" Width="400">

    <StackPanel Margin="20">

        <TextBlock Text="First Name:" FontWeight="Bold"/>
        <TextBox Text="Stary" Height="25" Margin="0,0,0,10" Name="f"/>

        <TextBlock Text="Last Name:" FontWeight="Bold"/>
        <TextBox Height="25" Margin="0,0,0,20" Text="Dzwoni" Name="l"/>

        <TextBlock Text="First Name" FontWeight="Bold"/>
        <TextBlock Text="{Binding Text, ElementName=f}" FontWeight="Bold"/>
        
        <TextBlock Text="Last Name:" FontWeight="Bold"/>
        <TextBlock Text="{Binding Text, ElementName=l}" FontWeight="Bold"/>

    </StackPanel>
</Window>