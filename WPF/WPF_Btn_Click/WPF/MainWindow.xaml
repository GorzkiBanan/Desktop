<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp"
        Title="Custom Data Binding Example" Height="300" Width="400">

    <StackPanel Margin="20">

        <TextBlock Text="Login:" FontWeight="Bold"/>
        <TextBox Height="25" Margin="0,0,0,10" Name="l"/>

        <TextBlock Text="Hasło:" FontWeight="Bold"/>
        <PasswordBox Height="25" Margin="0,0,0,20" Name="p"/>

		<Button
            Name="Btn_Custom"
            Click="Btn_Custom_Click"
            Content="Click"
            Background="Green">
		</Button>

    </StackPanel>
</Window>